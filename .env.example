# URL do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Settings > API > service_role (Secret). Nunca use esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui

# Nome exato da tabela criada no Supabase.
SUPPORT_TABLE_NAME=support-messagens

# Colunas existentes na tabela. Ajuste caso o seu banco use nomes em inglês.
SUPPORT_CATEGORY_COLUMN=categoria
SUPPORT_MESSAGE_COLUMN=mensagem
SUPPORT_CREATED_AT_COLUMN=created_at

# Domínios autorizados a enviar mensagens, separados por vírgula.
ALLOWED_ORIGINS=https://seu-site.vercel.app,https://seudominio.com
